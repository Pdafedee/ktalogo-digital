# ═══════════════════════════════════════════════════════════════════
#  Ktalogo-Dgital · variables de entorno (copia este archivo a .env)
#  Importante: los comentarios van SOLO en líneas separadas,
#  nunca después del valor (evita errores al convertir números).
# ═══════════════════════════════════════════════════════════════════

# ── IA · OpenAI híbrido (opcional: sin clave funciona en modo offline) ──
OPENAI_API_KEY=
# Modelo de chat compatible con OpenAI-API.
OPENAI_MODEL=gpt-4o-mini
# Base URL compatible con proveedores OpenAI-API (deja comentada para OpenAI).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Timeout en segundos para llamadas al modelo.
# OPENAI_TIMEOUT=15

# ── Persistencia ───────────────────────────────────────────────────────
# Modo: auto | json | sqlite ("auto" migra solo al superar el umbral).
KTALOGO_DB=auto
# Umbral de migración automática JSON→SQLite, en kilobytes.
KTALOGO_JSON_MIGRATE_KB=512
# DSN para escalar a MySQL o PostgreSQL cuando lo necesites:
# KTALOGO_MYSQL_DSN=mysql+pymysql://usuario:clave@localhost:3306/ktalogo_dgt
# KTALOGO_PG_DSN=postgresql+psycopg://usuario:clave@localhost:5432/ktalogo_dgt

# ── Blockchain local ───────────────────────────────────────────────────
# Ceros iniciales del hash (prueba de trabajo). 1-6.
KTALOGO_CHAIN_DIFFICULTY=3

# ── Email (autenticación con código) · opcional ────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# 1 = pedir código por email en cada login.
KTALOGO_2FA=0

# ── Pasarelas (v1 simuladas; 1 + claves = integración real) ────────────
KTALOGO_REAL_PAYMENTS=0
# QVAPAY_APP_ID=
# QVAPAY_SECRET=

# ── Tasa BCV ───────────────────────────────────────────────────────────
# Horas de vigencia de la tasa guardada en caché.
KTALOGO_RATE_TTL_H=6
# Tasa de respaldo si no hay internet (USD → VES).
KTALOGO_DEFAULT_TASA=40.0

# ── Recursos (poca señal) ──────────────────────────────────────────────
# Peso máximo de imágenes comprimidas, en KB.
KTALOGO_MAX_IMG_KB=220
